!/artifacts/e2_e3_comparison_dev_100.json
/outputs/*
!/outputs/teacher_deepseek_pilot_v3/
/outputs/teacher_deepseek_pilot_v3/*
!/outputs/teacher_deepseek_pilot_v3/quality_audit.json
/output/
/tmp/
/eval/

